# ─────────────────────────────────────────────────────────────
# Ledgerly environment variables
# Leave everything empty to run in DEMO MODE (sample data, no login).
# Fill in BOTH Firebase blocks below to switch to Firebase.
# Setting only some Firebase variables is refused (the app will not fall back to the open demo).
# ─────────────────────────────────────────────────────────────

# ── Browser (Firebase Auth only) ─────────────────────────────
# Firebase console → Project settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server (Next.js API routes → Firebase Admin SDK) ─────────
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with \n for newlines, wrapped in double quotes
FIREBASE_PRIVATE_KEY=
# Receipts are stored here (defaults to <project-id>.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# ── Optional: online payment links on invoices (Razorpay) ────
# Dashboard → Account & Settings → API keys. Without these, invoices have no payment link.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://<your-domain>/api/webhooks/razorpay, event "payment_link.paid"
RAZORPAY_WEBHOOK_SECRET=

# ── Optional: daily recurring-invoice job (Vercel Cron) ──────
# Any long random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ── Local emulators (optional, instead of a real project) ────
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
