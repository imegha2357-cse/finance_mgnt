rules_version = '2';

// All reads and writes go through the Next.js API, which uses the Admin SDK
// (Admin SDK bypasses these rules). Browsers never talk to Firestore directly,
// so we deny everything here. This keeps permissions, approvals and ledger
// postings enforced in one place on the server.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
